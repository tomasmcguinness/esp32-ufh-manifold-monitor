# Waveshare ESP32-S3-ETH: 16MB flash, 8MB octal PSRAM, W5500 SPI Ethernet, OV5640 on the DVP connector
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Network OTA (POST /api/ota into ota_0/ota_1). A new image must reach "IP + web server up"
# and call esp_ota_mark_app_valid_cancel_rollback(), or the next boot falls back.
# This is a bootloader option: it only takes effect after a USB flash of the bootloader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM holds the camera frame buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Ethernet only
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Console on the USB-Serial-JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Camera: leave the driver's default sensor list enabled so it auto-detects whatever is
# fitted and logs "Detected <model> camera". Restricting it to OV5640 failed with
# "Detected camera not supported" on the first real board.
CONFIG_SCCB_HARDWARE_I2C_PORT1=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
